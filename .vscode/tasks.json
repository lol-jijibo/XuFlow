{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动桌面端 (Tauri Dev)",
      "type": "npm",
      "script": "dev:desktop",
      "path": ".",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*tauri.*ready.*|.*listening on.*|.*vite.*ready.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}